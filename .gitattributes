# Normalise line endings; checked out native, stored LF.
* text=auto

# Unity YAML assets — mark as text so UnityYAMLMerge can resolve conflicts.
*.unity      text merge=unityyamlmerge eol=lf
*.prefab     text merge=unityyamlmerge eol=lf
*.asset      text merge=unityyamlmerge eol=lf
*.mat        text merge=unityyamlmerge eol=lf
*.anim       text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.meta       text eol=lf
*.asmdef     text eol=lf
*.cs         text diff=csharp

# Binary assets — never diff or merge these.
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.unitypackage binary
